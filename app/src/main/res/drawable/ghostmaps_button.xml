<?xml version="1.0" encoding="utf-8"?>
<!-- GhostMaps row buttons: dark fill, light outline, so white/amber/red text stays
     readable at full screen brightness (the default light-gray button washed it out) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/button_fill_disabled" />
            <stroke android:width="1dp" android:color="@color/button_outline_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/button_fill_pressed" />
            <stroke android:width="1dp" android:color="@color/button_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/button_fill" />
            <stroke android:width="1dp" android:color="@color/button_outline" />
        </shape>
    </item>
</selector>
